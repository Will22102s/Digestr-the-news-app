{
  "name": "the-daily-digest",
  "version": "0.1.0",
  "private": true,
  "description": "A minimalist, Apple-style daily reader for AI and cybersecurity news.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
