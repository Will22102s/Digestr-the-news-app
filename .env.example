# ---------------------------------------------------------------------------
# The Daily Digest — environment
# Copy this file to `.env` and fill in your Gemini key.
#
# Desktop builds do not need this file: users add their Gemini key in the
# in-app Settings dialog, where it is stored in the local SQLite database.
# ---------------------------------------------------------------------------

# SQLite database file. Relative paths resolve from the project root.
# The `data/` folder is created automatically.
DATABASE_URL=./data/digest.db

# Optional: point the desktop sidecar at an OS app-data directory instead.
# The Tauri shell sets this automatically; it is mainly useful for testing.
# DIGEST_DATA_DIR=

# Google Gemini API key: https://aistudio.google.com/apikey
# Optional fallback for development and server deployments. A key saved in
# Settings takes precedence, so end users never need to edit this file.
GEMINI_API_KEY=

# Model used by the editorial synthesis engine.
GEMINI_MODEL=gemini-3.8-flash

# Optional shared secret for protecting ingestion/synthesis endpoints.
# Leave empty for local development.
CRON_SECRET=

# How many feeds to fetch in parallel during a sync (1–50).
SYNC_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Desktop build only
# ---------------------------------------------------------------------------

# Override the Node executable copied into the Tauri sidecar. By default the
# build uses the host Node binary, or downloads the official build when the
# host binary depends on a shared libnode.
# DIGEST_NODE_BINARY=

# Override the Node version downloaded for the sidecar (defaults to the host
# Node version).
# DIGEST_NODE_VERSION=
