# ---------------------------------------------------------------------------
# Digestr — environment
# Copy this file to `.env` and fill in a provider key if you want live AI.
#
# Desktop builds do not need this file: users add keys in the in-app Settings
# dialog, where they are stored in the local SQLite database.
#
# The app works with no keys at all. A fresh database loads the Demo Mode
# library, and briefing generation falls back to the built-in algorithmic
# editor whenever no provider is configured or reachable.
# ---------------------------------------------------------------------------

# SQLite database file. Relative paths resolve from the project root.
# The `data/` folder is created automatically.
DATABASE_URL=./data/digest.db

# Optional: point the desktop sidecar at an OS app-data directory instead.
# The Tauri shell sets this automatically; it is mainly useful for testing.
# DIGEST_DATA_DIR=

# Preferred provider: auto | gemini | groq | ollama | fallback.
# `auto` tries Gemini, then Groq, then Ollama, then the built-in editor.
AI_PROVIDER=auto

# Google Gemini: https://aistudio.google.com/apikey
# Optional fallback for development and server deployments. A key saved in
# Settings takes precedence, so end users never need to edit this file.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Groq: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local Ollama: https://ollama.com
# Set OLLAMA_ENABLED=true to allow local inference.
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Optional shared secret for protecting ingestion/synthesis endpoints.
# Leave empty for local development.
CRON_SECRET=

# How many feeds to fetch in parallel during a sync (1–50).
SYNC_CONCURRENCY=8

# ---------------------------------------------------------------------------
# Desktop build only
# ---------------------------------------------------------------------------

# Override the Node executable copied into the Tauri sidecar. By default the
# build uses the host Node binary, or downloads the official build when the
# host binary depends on a shared libnode.
# DIGEST_NODE_BINARY=

# Override the Node version downloaded for the sidecar (defaults to the host
# Node version).
# DIGEST_NODE_VERSION=
