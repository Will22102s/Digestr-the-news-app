{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "The Daily Digest",
  "version": "0.1.0",
  "identifier": "com.dailydigest.desktop",
  "build": {
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare",
    "frontendDist": "placeholder"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../.next/standalone/": "standalone/"
    },
    "externalBin": ["binaries/digest-node"],
    "category": "News",
    "shortDescription": "A calm daily reader for AI and cybersecurity.",
    "longDescription": "The Daily Digest turns AI and cybersecurity headlines into one cited, editorial briefing. It stores its library locally in SQLite and works without an account.",
    "copyright": "© 2026 The Daily Digest"
  }
}
